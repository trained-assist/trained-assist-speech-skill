  "private": true,
  "description": "Speech / speech-to-text domain skill (speech_transcribe) — MCP server mounted by trained-assist-agent as the speech-skills sibling",
  "main": "src/mcp-skills/index.js",
  "scripts": {
    "check": "node -e \"require('fs').readdirSync('src/mcp-skills/tools').forEach(f => require('./src/mcp-skills/tools/'+f))\" && node --check src/mcp-skills/index.js",
